{
  "name": "featuretree-app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "bake": "cd ../models && ../.venv/bin/python -m ftbake",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && oxlint src e2e && vitest run src/tests",
    "dev:api": "STUDIO_DATA_DIR=.tmp/studio tsx watch server/index.ts",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning",
    "eval:studio": "tsx scripts/studio-eval.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/react": "^4.0.167",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "@salusoft89/planegcs": "^1.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.16",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "culori": "^4.0.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
