{
 "kind": "part",
 "id": "box_fillet_first",
 "title": "小盒子 A：先圆角后抽壳",
 "subtitle": "圆角先后对比 · 同一个盒子的两种做法",
 "level": "入门",
 "teaches": [
  "特征顺序决定结果",
  "抽壳会偏移圆角",
  "内外圆角同心，壁厚均匀"
 ],
 "params": [
  {
   "id": "L",
   "label": "长",
   "unit": "mm",
   "default": 60.0,
   "values": [],
   "feature": "sk1"
  },
  {
   "id": "W",
   "label": "宽",
   "unit": "mm",
   "default": 40.0,
   "values": [],
   "feature": "sk1"
  },
  {
   "id": "H",
   "label": "高",
   "unit": "mm",
   "default": 30.0,
   "values": [],
   "feature": "ext1"
  },
  {
   "id": "r",
   "label": "外圆角",
   "unit": "mm",
   "default": 4,
   "values": [
    2,
    4,
    6,
    8
   ],
   "feature": "fil1"
  },
  {
   "id": "t",
   "label": "壁厚",
   "unit": "mm",
   "default": 2.5,
   "values": [
    1.5,
    2.5,
    4
   ],
   "feature": "shell1"
  }
 ],
 "features": [
  {
   "id": "sk1",
   "op": "sketch",
   "name": "草图1",
   "title": "底面矩形",
   "why": "两种做法从同一张草图开始：一个 60 × 40 的矩形，画在上视基准面上，中心在原点。",
   "summary": "上视基准面 · 60.0 × 40.0",
   "summaryTemplate": "上视基准面 · {L} × {W}",
   "pitfall": "",
   "view": [
    0,
    0,
    1
   ],
   "focus": null,
   "code": "outline = Rectangle(p[\"L\"], p[\"W\"])"
  },
  {
   "id": "ext1",
   "op": "extrude",
   "name": "拉伸1",
   "title": "实心盒体",
   "why": "拉伸成一块实心的料。到这里 A 和 B 完全一样，分歧从下一步开始。",
   "summary": "高 30.0",
   "summaryTemplate": "高 {H}",
   "pitfall": "",
   "view": [
    1.0,
    -1.1,
    0.85
   ],
   "focus": null,
   "code": "box = extrude(outline, amount=p[\"H\"])"
  },
  {
   "id": "fil1",
   "op": "fillet",
   "name": "圆角1",
   "title": "外圆角",
   "why": "做法 A 先在实心块上倒圆角：四条竖边和底面四条边，顶面那圈留着做开口。实心块上倒圆角最简单，不用担心壁厚。",
   "summary": "R4 · 竖边 + 底边，共 8 条",
   "summaryTemplate": "R{r} · 竖边 + 底边，共 8 条",
   "pitfall": "这一步的半径决定了下一步抽壳能不能成功：它必须比壁厚大。",
   "view": [
    1,
    -1.1,
    -0.6
   ],
   "focus": null,
   "code": "top_rim = box.edges().group_by(Axis.Z)[-1]\nbox = fillet(box.edges() - top_rim, radius=p[\"r\"])  # 竖边 + 底边"
  },
  {
   "id": "shell1",
   "op": "shell",
   "name": "抽壳1",
   "title": "掏空盒体",
   "why": "抽壳把每个面向内偏移一个壁厚，外圆角也被偏移成一个同心的内圆角，半径是「r − t」。所以 A 的内角是圆的，转角处的壁厚和平面处一样。对比做法 B：B 的内角是尖的，转角处的壁更薄。",
   "summary": "壁厚 2.5 · 移除顶面",
   "summaryTemplate": "壁厚 {t} · 移除顶面",
   "pitfall": "圆角正好等于壁厚时，内圆角半径为零，抽壳失败。圆角比壁厚小时，内角又变回尖角。",
   "view": [
    0.8,
    -1,
    1.6
   ],
   "focus": null,
   "code": "top = box.faces().sort_by(Axis.Z)[-1]\nbox = offset(box, amount=-p[\"t\"], openings=top)"
  }
 ],
 "failures": {
  "shell1": "外圆角等于壁厚：抽壳要把 R 圆角向内偏移出一个半径为「圆角 − 壁厚」的内圆角，半径正好为零时内核算不出来。让圆角明显大于壁厚，内角是同心圆角；明显小于壁厚，内角是尖角。"
 },
