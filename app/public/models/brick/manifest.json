{
 "kind": "part",
 "id": "brick",
 "title": "积木砖",
 "subtitle": "计数驱动 · 抽壳 · 矩形阵列",
 "level": "入门",
 "teaches": [
  "用数量驱动尺寸",
  "先抽壳再加凸点",
  "矩形阵列",
  "底管卡住凸点"
 ],
 "params": [
