 ],
 "features": [
  {
   "id": "sk1",
   "op": "sketch",
   "name": "草图1",
   "title": "外形轮廓",
   "why": "外形直接画成圆角矩形，四个竖直的大圆角在草图里就有了，不用再单独倒。草图圆角比实体圆角稳：后面的拔模、抽壳都是在一个干净的外形上做。",
   "summary": "上视基准面 · 68.0 × 52.0 · R10.0",
   "summaryTemplate": "上视基准面 · {W} × {L} · R{R}",
   "pitfall": "",
   "view": [
    0,
    0,
    1
   ],
   "focus": null,
   "code": "outline = RectangleRounded(p[\"W\"], p[\"L\"], p[\"R\"])"
  },
  {
   "id": "ext1",
   "op": "extrude",
   "name": "拉伸1",
   "title": "实心壳体",
   "why": "拉到 11 mm，顶面就是上下壳的分型面。上盖也从这个面开始往上长，两个零件在这里对齐。",
   "summary": "高 11.0",
   "summaryTemplate": "高 {H}",
   "pitfall": "",
   "view": [
    1.0,
    -1.1,
    0.85
   ],
   "focus": null,
   "code": "body = extrude(outline, amount=p[\"H\"])"
  },
  {
   "id": "dft1",
   "op": "draft",
   "name": "拔模1",
   "title": "外壁拔模",
   "why": "外壁向下收 1°。中性面放在分型面 z = 11 上，这里的外形保持 68 × 52 不变，和上盖严丝合缝；越往底部越小，模具一打开，零件就能从型腔里脱出来。四个圆角是圆锥面，也一起拔模了。",
   "summary": "1° · 中性面 z = 11.0 · 向下收",
   "summaryTemplate": "{a}° · 中性面 z = {H} · 向下收",
   "pitfall": "中性面放在底面，变的就是分型面处的外形，和上盖对不齐了。",
   "view": [
    1,
    -0.3,
    0.15
   ],
   "focus": null,
   "code": "sides = body.faces() - body.faces().filter_by(Axis.Z)  # 四面平壁 + 四个圆角\nparting = Plane(origin=(0, 0, p[\"H\"]), z_dir=(0, 0, -1))  # 中性面在分型面上，型腔向下脱开\nbody = draft(sides, parting, angle=p[\"a\"])"
  },
  {
   "id": "shell1",
   "op": "shell",
   "name": "抽壳1",
   "title": "掏空壳体",
   "why": "移除顶面抽壳，底板和侧壁一样厚。拔模放在抽壳之前，内壁是从外壁偏移出来的，也带着同样的 1°，型芯同样拔得出来。",
   "summary": "壁厚 1.8 · 移除顶面",
   "summaryTemplate": "壁厚 {t} · 移除顶面",
   "pitfall": "先抽壳再拔模，要分别选内外两圈面，很容易漏选，壁厚也会变得不均匀。",
   "view": [
    0.8,
    -1,
    1.6
   ],
   "focus": null,
   "code": "top = body.faces().sort_by(Axis.Z)[-1]\nbody = offset(body, amount=-t, openings=top)"
  },
  {
   "id": "boss1",
   "op": "extrude",
   "name": "拉伸2",
   "title": "螺丝柱",
   "why": "四个螺丝柱从底板长到 z = 10.8，主板就压在柱顶上。柱子留在离侧壁 3 mm 左右的地方，螺丝刀和电池座都有地方放。",
   "summary": "Ø6 × 4 · 底板到 z = 10.8",
   "summaryTemplate": "Ø{D} × 4 · 底板到 z = 10.8",
   "pitfall": "螺丝柱直接贴在侧壁上，那一处的壁会变得很厚，外面缩出凹坑。",
   "view": [
    0.8,
    -1,
    1.6
   ],
   "focus": null,
   "code": "body += Pos(0, 0, t) * Locations(*BOSSES) * Cylinder(D / 2, BOSS_TOP - t, align=UP)"
  },
  {
   "id": "rib1",
   "op": "rib",
   "name": "筋1",
   "title": "加强筋",
   "why": "每个螺丝柱向最近的两面侧壁各拉一条筋，拧螺丝时柱子不会被拧歪。筋厚取壁厚的 60%，筋和侧壁相交处不会因为太厚而缩水。筋比柱子矮一截，上面留出放主板元件的空间。",
   "summary": "筋厚 0.6 × 1.8 · 高 5.2",
   "summaryTemplate": "筋厚 0.6 × {t} · 高 5.2",
   "pitfall": "筋和壁一样厚，背面会出现一道缩痕。",
   "view": [
    0.8,
    -1,
    1.6
   ],
   "focus": [
    [
     16,
     8,
     0
    ],
    [
     34.0,
     26.0,
     11.0
    ]
   ],
   "code": "rib_t, rib_h = 0.6 * t, 5.2  # 筋厚取壁厚的 60%\nribs = []\nfor x, y in BOSSES:\n    wx = copysign(p[\"W\"] / 2 - t / 2, x)  # 筋一直伸到侧壁的壁厚中间\n    wy = copysign(p[\"L\"] / 2 - t / 2, y)\n    ribs += [\n        Pos((x + wx) / 2, y, t) * Box(abs(wx - x), rib_t, rib_h, align=UP),\n        Pos(x, (y + wy) / 2, t) * Box(rib_t, abs(wy - y), rib_h, align=UP),\n    ]\nbody += ribs"
  },
  {
   "id": "hole1",
   "op": "hole",
   "name": "孔1",
   "title": "螺丝过孔",
   "why": "孔从底面一直打穿螺丝柱。自攻螺丝从底部穿进来，穿过主板，拧进上盖的螺丝柱；底壳这一侧只是过孔，比 M2 螺丝大一点。",
   "summary": "Ø2.4 × 4 · 贯穿",
   "summaryTemplate": "Ø{dh} × 4 · 贯穿",
   "pitfall": "",
   "view": [
    0.6,
    -0.8,
    -1.4
   ],
   "focus": null,
   "code": "body -= Locations(*BOSSES) * Cylinder(p[\"dh\"] / 2, p[\"H\"], align=UP)"
  },
  {
   "id": "fil1",
   "op": "fillet",
   "name": "圆角1",
   "title": "柱根圆角",
   "why": "螺丝柱和底板的交线倒一个小圆角，应力不会集中在尖角上，塑料流动也更顺。圆角放在最后：筋和孔都已经确定，它只修饰交线。",
   "summary": "R0.4",
   "summaryTemplate": "R{rf}",
   "pitfall": "柱根圆角太大，等于在根部堆了一圈料，又会变厚缩水。",
   "view": [
    0.8,
    -1,
    1.6
   ],
   "focus": [
    [
     16,
     8,
     0
    ],
    [
     34.0,
     26.0,
     11.0
    ]
   ],
   "code": "boss_walls = body.faces().filter_by(GeomType.CYLINDER).filter_by(lambda f: abs(f.radius - D / 2) < 1e-3)\nroots = boss_walls.edges().filter_by(lambda e: abs(e.center().Z - t) < 1e-3)  # 柱子和底板的交线\nbody = fillet(roots, radius=p[\"rf\"])"
  }
 ],
 "failures": {
  "dft1": "拔模失败：内核没能把圆角处的圆柱面转成圆锥面。",
  "shell1": "抽壳失败：壁厚太厚，内腔放不下。",
  "rib1": "加强筋没有和螺丝柱、侧壁连成一个实体。",
  "fil1": "柱根圆角放不下：圆角和筋的根部撞在一起。"
 },
