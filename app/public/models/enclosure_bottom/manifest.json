{
 "kind": "part",
 "id": "enclosure_bottom",
 "title": "温湿度计底壳",
 "subtitle": "拔模 · 抽壳 · 螺丝柱 · 加强筋",
 "level": "进阶",
 "teaches": [
  "壁厚处处一致",
  "拔模让零件脱得出模",
  "螺丝柱用筋连到侧壁",
  "筋厚约为壁厚的 60%"
 ],
