{
 "kind": "part",
 "id": "gear",
 "title": "直齿轮",
 "subtitle": "渐开线 · 模数与齿数驱动 · 圆周阵列",
 "level": "进阶",
 "teaches": [
  "派生尺寸：分度圆 = m × z",
  "只画一个齿",
  "圆周阵列",
  "孔径跟着齿轮走"
 ],
 "params": [
