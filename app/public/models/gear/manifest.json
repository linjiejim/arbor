 ],
 "features": [
  {
   "id": "sk1",
   "op": "sketch",
   "name": "草图1",
   "title": "齿根圆",
   "why": "齿轮所有的圆都由模数和齿数算出来：分度圆 d = m × z，齿顶圆大一个 m，齿根圆小 1.25 m。草图里只画齿根圆，其余几个圆画成构造线，给后面画齿当参照。",
   "summary": "分度圆 d = m × z = 1.5 × 18 = 27",
   "summaryTemplate": "",
   "pitfall": "不要把分度圆直径直接写成数字：以后改齿数，它就对不上了。",
   "view": [
    0,
    0,
    1
   ],
   "focus": null,
   "code": "d = m * z  # 分度圆\nrb, ra, rf = d / 2 * cos(ALPHA), d / 2 + m, d / 2 - 1.25 * m  # 基圆、齿顶圆、齿根圆\nroot = Circle(rf)"
  },
  {
   "id": "ext1",
   "op": "extrude",
   "name": "拉伸1",
   "title": "齿根圆柱",
   "why": "先拉出齿根圆柱，相当于轮坯。齿是后面一个一个长上去的。",
   "summary": "齿宽 8",
   "summaryTemplate": "齿宽 {B}",
   "pitfall": "",
   "view": [
    1.0,
    -1.1,
    0.85
   ],
   "focus": null,
   "code": "gear = extrude(root, amount=B)"
  },
  {
   "id": "sk2",
   "op": "sketch",
   "name": "草图2",
   "title": "一个齿",
   "why": "草图画在齿根圆柱的顶面上。齿面是渐开线：一根绳子绕在基圆上，拉直时绳端走过的轨迹。两齿啮合时，这条曲线让传动比始终不变。这里在基圆和齿顶圆之间取 8 个点画样条，另一侧镜像得到。",
   "summary": "压力角 20° · 渐开线齿廓",
   "summaryTemplate": "压力角 {alpha}° · 渐开线齿廓",
   "pitfall": "齿数少于 17 时，真实加工会根切掉齿根的一部分。这里画的是理论齿形。",
   "view": [
    0,
    0,
    1
   ],
   "focus": [
    [
     10.5,
     -3.0,
     0
    ],
    [
     16.5,
     3.0,
     8
    ]
   ],
   "code": "half = pi / (2 * z) + inv(ALPHA)  # 半个齿在基圆上张开的角度\n\nr0 = max(rb, rf)  # 渐开线从基圆开始，到齿顶圆结束\nradii = [r0 + (ra - r0) * i / 7 for i in range(8)]\ntheta = [half - inv(acos(rb / q)) for q in radii]  # 渐开线上各点的极角\nupper = Spline(*[(q * cos(a), q * sin(a)) for q, a in zip(radii, theta)])\nlower = upper.mirror(Plane.XZ)\nfoot = (rf - 0.5 * m) / r0  # 齿脚伸进齿根圆\ntop = Plane.XY.offset(B)  # 画在齿根圆柱的顶面上\ntooth = top * make_face([\n    lower,\n    ThreePointArc(lower @ 1, (ra, 0), upper @ 1),  # 齿顶\n    upper,\n    Polyline(upper @ 0, (upper @ 0) * foot, (lower @ 0) * foot, lower @ 0),  # 齿根\n])"
  },
  {
   "id": "ext2",
   "op": "extrude",
   "name": "拉伸2",
   "title": "第一个齿",
   "why": "把齿廓从顶面向下拉伸一个齿宽，同时和轮坯合并。齿脚特意伸进齿根圆里一点，两个实体有重叠，合并才可靠。",
   "summary": "齿宽 8 · 合并",
   "summaryTemplate": "齿宽 {B} · 合并",
   "pitfall": "",
   "view": [
    1.0,
    -1.1,
    0.85
   ],
   "focus": [
    [
     10.5,
     -3.0,
     0
    ],
    [
     16.5,
     3.0,
     8
    ]
   ],
   "code": "tooth = extrude(tooth, amount=B, dir=(0, 0, -1))  # 向下拉到底面\ngear += tooth"
  },
  {
   "id": "pat1",
   "op": "pattern",
   "name": "阵列1",
   "title": "圆周阵列",
   "why": "绕中心轴把第一个齿复制成 z 个，等角度分布。改齿数只需要改阵列的个数，齿廓和各个圆会跟着重算。",
   "summary": "18 个 · 360° 等分",
   "summaryTemplate": "{z} 个 · 360° 等分",
   "pitfall": "",
   "view": [
    1.0,
    -1.1,
    0.85
   ],
   "focus": null,
   "code": "gear += PolarLocations(0, z) * tooth"
  },
  {
   "id": "hole1",
   "op": "hole",
   "name": "孔1",
   "title": "轴孔",
   "why": "轴孔直径取分度圆的 0.4 倍再取整，也是派生尺寸：齿轮变大，孔跟着变大，轮缘始终留得出足够的厚度。",
   "summary": "Ø11 ≈ 0.4 × 分度圆 · 贯穿",
   "summaryTemplate": "",
   "pitfall": "孔太大会让齿根下面的轮缘太薄，受力时从齿根裂开。",
   "view": [
    0.8,
    -0.9,
    1.4
   ],
   "focus": null,
   "code": "bore = round(0.4 * d)  # 孔径 ≈ 0.4 倍分度圆，取整\ngear -= Cylinder(bore / 2, B, align=UP)"
  },
  {
   "id": "cha1",
   "op": "chamfer",
   "name": "倒角1",
   "title": "孔口与齿顶倒角",
   "why": "孔口倒角方便把齿轮压到轴上；齿顶两端倒角去掉锐边，装配时不会刮伤，也不容易崩齿。倒角放在最后，它只修饰，不改变任何尺寸关系。",
   "summary": "孔口 C0.5 · 齿顶 C0.375",
   "summaryTemplate": "",
   "pitfall": "",
   "view": [
    0.8,
    -0.9,
    1.4
   ],
   "focus": null,
   "code": "circles = gear.edges().filter_by(GeomType.CIRCLE)\ngear = chamfer(circles.filter_by(lambda e: abs(e.radius - bore / 2) < 1e-3), length=p[\"c\"])\ntips = gear.edges().filter_by(GeomType.CIRCLE).filter_by(lambda e: abs(e.radius - ra) < 1e-3)\ngear = chamfer(tips, length=0.25 * m)"
  }
 ],
 "failures": {
  "ext2": "齿没有和轮坯合并成一个实体。",
  "pat1": "阵列后的齿没有和轮坯合并成一个实体。",
  "cha1": "倒角失败：齿顶太窄，放不下这么大的倒角。"
 },
