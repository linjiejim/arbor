{
 "kind": "part",
 "id": "keycap",
 "title": "机械键盘键帽",
 "subtitle": "放样 · 球面切除 · 抽壳 · 十字轴座",
 "level": "进阶",
 "teaches": [
  "放样出斜面，顺带拔模",
  "球面碟的深度由半径决定",
  "抽壳让顶板和裙边一样厚",
  "轴座拉伸到顶板下表面"
 ],
 "params": [
  {
   "id": "B",
