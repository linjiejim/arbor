{
  "name": "arbor",
  "productName": "Arbor",
  "version": "0.3.1",
  "description": "Desktop workbench where a local coding agent builds parametric parts over MCP or a CLI, and you watch, tweak and annotate.",
  "private": true,
  "license": "MIT",
  "author": "Jim Lin",
  "type": "module",
  "main": "dist/main.mjs",
  "bin": { "arbor": "bin/arbor" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "start": "electron .",
    "check": "../app/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-mcp.mjs",
    "test": "node --test src/update/*.test.ts",
    "icons": "node scripts/icons.mjs",
    "dist": "node scripts/build.mjs && electron-builder --mac dir --publish never && node scripts/release.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
