      "on": {
        "plane": "XY"
      },
      "shapes": [
        {
          "type": "rect",
          "w": "L",
          "h": "W",
          "r": "r"
        }
      ]
    },
    {
      "id": "body",
      "name": "实心外形",
      "intent": "先拉出整块实心外形,之后挖内腔、再一刀分成底壳和上盖,两件的外形天然对齐",
      "op": "extrude",
      "sketch": "sk_body",
      "distance": "H"
    },
    {
      "id": "top_round",
      "name": "顶面圆角",
