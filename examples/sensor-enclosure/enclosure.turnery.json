    {
      "id": "cavity",
      "name": "挖内腔",
      "intent": "上下各留一个壁厚,得到封闭的空腔",
      "op": "extrude",
      "sketch": "sk_cavity",
      "distance": "H-2*t",
      "mode": "cut"
    },
    {
      "id": "sk_posts",
